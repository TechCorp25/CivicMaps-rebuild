# CivicMAPS — local environment template
#
# Copy to `.env` and fill locally. `.env` is git-ignored; `.env.example` is not.
#
# RULE: this file documents variable NAMES ONLY. It must never carry a value for
# a provider token or credential. `scripts/verify/validate-deployment-wiring.mjs`
# rejects any assignment to RAILWAY_TOKEN, RAILWAY_API_TOKEN, EXPO_TOKEN,
# DATABASE_PASSWORD, WEBHOOK_SECRET or OAUTH_CLIENT_SECRET here.
#
# Provider access tokens, mobile signing material and live database credentials
# live in protected GitHub Environments or the provider dashboard.
# See docs/governance/CivicMAPS_Foundation_Build_External_Service_Wiring.md and
# configuration/deployment/github-environments.md.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
CIVICMAPS_ENVIRONMENT=local
TZ=Australia/Melbourne
CIVICMAPS_LOCALE=en-AU

# ── Governance posture ───────────────────────────────────────────────────────
# Mirrors civicmaps.workspace.json. Provisional build operates under an
# authenticated S03-ODR-RSK-001 risk acceptance with a hard expiry.
CIVICMAPS_IMPLEMENTATION_MODE=provisional
CIVICMAPS_DATA_CLASSIFICATION=synthetic-confidentiality-0

# ── API service ──────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=3000

# ── Data platform (provisional — ADR-gated, DSR-3 option A) ──────────────────
# Local development only. Synthetic data only under the ODR ceiling.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=civicmaps_local
DATABASE_USER=civicmaps
# DATABASE_PASSWORD — set in .env only, never here.

# ── Mobile (provisional — ADR-gated, DSR-1 option A) ─────────────────────────
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
EXPO_PUBLIC_ENVIRONMENT=local
# EXPO_TOKEN — CI secret, never here.

# ── Hosting (provisional — non-production dev/test only, DSR-4 option B) ─────
# RAILWAY_TOKEN — CI secret, never here.

# ── Naming / identity ────────────────────────────────────────────────────────
# See docs/civicmaps-naming-pack/.env.naming.example for the canonical
# identity variables and EXPO-EAS-IDENTITY-STANDARD.md.
