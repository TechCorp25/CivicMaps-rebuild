{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CivicMAPS F06 Sydney development ingress, synthetic acceptance only",
  "Parameters": {
    "ImageId": {
      "Type": "AWS::EC2::Image::Id"
    },
    "VpcId": {
      "Type": "String"
    },
    "SubnetId": {
      "Type": "String"
    },
    "DatabaseSecurityGroup": {
      "Type": "String"
    },
    "ArtifactBucket": {
      "Type": "String"
    }
  },
  "Resources": {
    "RuntimeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "F06Resources",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue",
                    "secretsmanager:DescribeSecret"
                  ],
                  "Resource": [
                    "arn:aws:secretsmanager:ap-southeast-2:597663815195:secret:civicmaps/f05/f0500000-0000-4000-8000-000000000001-*",
                    "arn:aws:secretsmanager:ap-southeast-2:597663815195:secret:civicmaps/f05/f0500000-0000-4000-8000-000000000002-*"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "arn:aws:s3:::${ArtifactBucket}/f06/releases/*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CivicMAPS"
          },
          {
            "Key": "Feature",
            "Value": "F06"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          },
          {
            "Key": "ReviewAfter",
            "Value": "2026-10-21"
          }
        ]
      }
    },
    "StorageRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::GetAtt": [
                    "RuntimeRole",
                    "Arn"
                  ]
                }
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "TwoAcceptanceNamespaces",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::Sub": "arn:aws:s3:::${ArtifactBucket}"
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": [
                        "municipalities/20000000-0000-4000-8000-000000000001/f0500000-0000-4000-8000-000000000001/*",
                        "municipalities/20000000-0000-4000-8000-000000000002/f0500000-0000-4000-8000-000000000002/*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:s3:::${ArtifactBucket}/municipalities/20000000-0000-4000-8000-000000000001/f0500000-0000-4000-8000-000000000001/*"
                    },
                    {
                      "Fn::Sub": "arn:aws:s3:::${ArtifactBucket}/municipalities/20000000-0000-4000-8000-000000000002/f0500000-0000-4000-8000-000000000002/*"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CivicMAPS"
          },
          {
            "Key": "Feature",
            "Value": "F06"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          },
          {
            "Key": "ReviewAfter",
            "Value": "2026-10-21"
          }
        ]
      }
    },
    "StorageAssumePolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "Roles": [
          {
            "Ref": "RuntimeRole"
          }
        ],
        "PolicyName": "AssumeScopedStorage",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "sts:AssumeRole",
              "Resource": {
                "Fn::GetAtt": [
                  "StorageRole",
                  "Arn"
                ]
              }
            }
          ]
        }
      }
    },
    "Profile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "RuntimeRole"
          }
        ]
      }
    },
    "WebSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "F06 HTTPS and ACME only; management through SSM",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "DestinationSecurityGroupId": {
              "Ref": "DatabaseSecurityGroup"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "CivicMAPS"
          },
          {
            "Key": "Feature",
            "Value": "F06"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          },
          {
            "Key": "ReviewAfter",
            "Value": "2026-10-21"
          }
        ]
      }
    },
    "DatabaseAccess": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DatabaseSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "SourceSecurityGroupId": {
          "Ref": "WebSecurityGroup"
        }
      }
    },
    "Runtime": {
      "Type": "AWS::EC2::Instance",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ImageId": {
          "Ref": "ImageId"
        },
        "InstanceType": "t3.micro",
        "IamInstanceProfile": {
          "Ref": "Profile"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "SubnetId": {
              "Ref": "SubnetId"
            },
            "AssociatePublicIpAddress": true,
            "GroupSet": [
              {
                "Ref": "WebSecurityGroup"
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "Encrypted": true,
              "VolumeSize": 16,
              "VolumeType": "gp3",
              "DeleteOnTermination": false
            }
          }
        ],
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "CivicMAPS"
          },
          {
            "Key": "Feature",
            "Value": "F06"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          },
          {
            "Key": "ReviewAfter",
            "Value": "2026-10-21"
          },
          {
            "Key": "Name",
            "Value": "civicmaps-f06-development"
          }
        ]
      }
    },
    "Address": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Project",
            "Value": "CivicMAPS"
          },
          {
            "Key": "Feature",
            "Value": "F06"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          },
          {
            "Key": "ReviewAfter",
            "Value": "2026-10-21"
          }
        ]
      }
    },
    "AddressAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "InstanceId": {
          "Ref": "Runtime"
        },
        "AllocationId": {
          "Fn::GetAtt": [
            "Address",
            "AllocationId"
          ]
        }
      }
    },
    "PlatformRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": "Z01841903TEW783OZ3RC",
        "Name": "platform.dev.civicmaps.com.au",
        "Type": "A",
        "TTL": "60",
        "ResourceRecords": [
          {
            "Ref": "Address"
          }
        ]
      }
    },
    "AlphacommandmapsRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": "Z01841903TEW783OZ3RC",
        "Name": "alpha-commandmaps.dev.civicmaps.com.au",
        "Type": "A",
        "TTL": "60",
        "ResourceRecords": [
          {
            "Ref": "Address"
          }
        ]
      }
    },
    "BetacommandmapsRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": "Z01841903TEW783OZ3RC",
        "Name": "beta-commandmaps.dev.civicmaps.com.au",
        "Type": "A",
        "TTL": "60",
        "ResourceRecords": [
          {
            "Ref": "Address"
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Runtime"
      }
    },
    "PublicIp": {
      "Value": {
        "Ref": "Address"
      }
    },
    "StorageRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "StorageRole",
          "Arn"
        ]
      }
    },
    "RuntimeRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "RuntimeRole",
          "Arn"
        ]
      }
    }
  }
}
