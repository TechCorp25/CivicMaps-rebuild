{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "ui_kits/commandmaps/**",
              "ui_kits/dispatch/**",
              "ui_kits/enforcementmaps/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:DM Sans|JetBrains Mono|Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: DM Sans, JetBrains Mono, Plus Jakarta Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='LifecycleStatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|key|ref|className|style|children)$/]",
        "message": "<LifecycleStatusPill> doesn't accept that prop. Declared props: status."
      },
      {
        "selector": "JSXOpeningElement[name.name='LifecycleStatusPill'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:RECEIVED|DISPATCHED_NOT_ACTIVE|DISPATCHED_ACTIVE|IN_PROGRESS|ATTENDED|PIN_ISSUED|NO_REPORT|COMPLETED|VOIDED|CANCELLED|CLOSED)$/]",
        "message": "<LifecycleStatusPill> status must be one of 'RECEIVED' | 'DISPATCHED_NOT_ACTIVE' | 'DISPATCHED_ACTIVE' | 'IN_PROGRESS' | 'ATTENDED' | 'PIN_ISSUED' | 'NO_REPORT' | 'COMPLETED' | 'VOIDED' | 'CANCELLED' | 'CLOSED'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PresenceIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|size|key|ref|className|style|children)$/]",
        "message": "<PresenceIndicator> doesn't accept that prop. Declared props: state, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='PresenceIndicator'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:available|active-offline|inactive)$/]",
        "message": "<PresenceIndicator> state must be one of 'available' | 'active-offline' | 'inactive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PresenceIndicator'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<PresenceIndicator> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioCodeBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|label|tier|defaultExpanded|key|ref|className|style|children)$/]",
        "message": "<RadioCodeBadge> doesn't accept that prop. Declared props: code, label, tier, defaultExpanded."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioCodeBadge'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:emergency|urgent|directive|alert-interactive|presence|comms|work)$/]",
        "message": "<RadioCodeBadge> tier must be one of 'emergency' | 'urgent' | 'directive' | 'alert-interactive' | 'presence' | 'comms' | 'work'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
